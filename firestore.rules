rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/gameData/{documentId} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && documentId == 'profile';

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && documentId == 'profile'
        && request.resource.data.keys().hasOnly([
          'sound',
          'reducedMotion',
          'bestScore',
          'expeditions',
          'relicsFound',
          'currentLevel',
          'swordTier',
          'armorTier',
          'checkpoint',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'sound',
          'reducedMotion',
          'bestScore',
          'expeditions',
          'relicsFound',
          'currentLevel',
          'swordTier',
          'armorTier',
          'checkpoint',
          'updatedAt'
        ])
        && request.resource.data.sound is bool
        && request.resource.data.reducedMotion is bool
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0
        && request.resource.data.expeditions is int
        && request.resource.data.expeditions >= 0
        && request.resource.data.relicsFound is int
        && request.resource.data.relicsFound >= 0
        && request.resource.data.currentLevel is int
        && request.resource.data.currentLevel >= 1
        && request.resource.data.currentLevel <= 9007199254740991
        && request.resource.data.swordTier is int
        && request.resource.data.swordTier >= 0
        && request.resource.data.swordTier <= 3
        && request.resource.data.armorTier is int
        && request.resource.data.armorTier >= 0
        && request.resource.data.armorTier <= 3
        && request.resource.data.checkpoint is string
        && request.resource.data.checkpoint.size() <= 20000
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }
  }
}
